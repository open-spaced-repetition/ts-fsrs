{
  "compilerOptions": {
    "lib": ["DOM", "ES2025"],
    "jsx": "react-jsx",
    "target": "ES2023",
    "noEmit": true,
    "skipLibCheck": true,
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./src/*"],
      "i18n": ["./src/i18n/en-US.json"],
      // Playground examples import the specifier an application installs. The
      // wasm32-wasip1 build is the platform artifact that ships those types.
      "@open-spaced-repetition/binding": [
        "../packages/binding/dist/fsrs-binding.wasip1.d.cts"
      ]
    },
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noUncheckedSideEffectImports": true,
    "isolatedModules": true,
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"]
  },
  "include": [
    "e2e",
    "playwright.config.ts",
    "src",
    "theme",
    "scripts",
    "rspress.config.ts",
    "search.ts",
    "vitest.config.ts"
  ],
  "mdx": {
    "checkMdx": true
  }
}
