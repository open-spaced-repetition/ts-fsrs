{
  "name": "@open-spaced-repetition/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:prepare": "pnpm prepare:packages && pnpm verify:packages",
    "docs:dev": "turbo run rspress:dev --filter=@open-spaced-repetition/docs",
    "docs:build": "turbo run rspress:build --filter=@open-spaced-repetition/docs",
    "rspress:dev": "pnpm docs:prepare && rspress dev",
    "rspress:build": "pnpm docs:prepare && rspress build",
    "preview": "rspress preview",
    "prepare:packages": "node scripts/prepare-wasm-package.mjs",
    "verify:packages": "node scripts/verify-packages.mjs"
  },
  "dependencies": {
    "@open-spaced-repetition/binding-wasm32-wasip1": "workspace:^",
    "ts-fsrs": "workspace:*"
  },
  "devDependencies": {
    "@rspress/core": "2.0.19",
    "@rspress/plugin-rss": "2.0.19"
  }
}
