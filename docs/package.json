{
  "name": "@ts-fsrs/website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "rspress:dev": "rspress dev",
    "rspress:build": "rspress build",
    "preview": "rspress preview",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit --pretty false",
    "test:docs": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "prepare:packages": "node scripts/prepare-wasm-package.mjs",
    "prepare:revlog": "node scripts/fetch-revlog.mjs",
    "prepare:sponsors": "node --env-file-if-exists=.env scripts/fetch-sponsors.mjs",
    "prepare:contributors": "node --env-file-if-exists=.env scripts/fetch-contributors.mjs",
    "verify:packages": "node scripts/verify-packages.mjs"
  },
  "dependencies": {
    "@open-spaced-repetition/binding-wasm32-wasip1": "workspace:^",
    "clsx": "^2.1.1",
    "monaco-editor": "0.56.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-json-view-lite": "^2.5.0",
    "temporal-polyfill": "^1.0.5",
    "ts-fsrs": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@rsbuild/plugin-tailwindcss": "^2.0.3",
    "@rspress/core": "2.0.22",
    "@rspress/plugin-rss": "2.0.22",
    "@rspress/plugin-sitemap": "2.0.22",
    "@rspress/plugin-twoslash": "2.0.22",
    "@types/mdast": "4.0.4",
    "@types/react": "19.3.0",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "shiki": "^4.4.3",
    "sponsorkit": "^18.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "unist-util-visit": "5.1.0"
  }
}
