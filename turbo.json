{
  "$schema": "./node_modules/turbo/schema.json",
  "globalDependencies": [
    "pnpm-lock.yaml",
    "Cargo.lock",
    "Cargo.toml",
    "packages/*/Cargo.toml",
    "package.json",
    "biome.json",
    ".github/actions/**",
    ".github/workflows/**"
  ],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@open-spaced-repetition/binding#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["NAPI_TARGET"],
      "passThroughEnv": ["ANDROID_NDK_LATEST_HOME"]
    },
    "@open-spaced-repetition/binding#build:wasm": {
      "cache": false,
      "env": ["WASI_SDK_PATH"]
    },
    "@open-spaced-repetition/binding#build:wasm:threadless": {
      "cache": false,
      "passThroughEnv": ["RUSTC_WRAPPER"]
    },
    "@open-spaced-repetition/docs#rspress:build": {
      "dependsOn": [
        "@open-spaced-repetition/binding#build:wasm:threadless",
        "ts-fsrs#build"
      ],
      "outputs": ["doc_build/**"],
      "env": ["DOCS_SITE_ORIGIN", "DOCS_REPO_SLUG", "DOCS_REPO_REF"]
    },
    "@open-spaced-repetition/docs#rspress:dev": {
      "dependsOn": [
        "@open-spaced-repetition/binding#build:wasm:threadless",
        "ts-fsrs#build"
      ],
      "with": ["ts-fsrs#dev"],
      "cache": false,
      "persistent": true,
      "env": ["DOCS_SITE_ORIGIN", "DOCS_REPO_SLUG", "DOCS_REPO_REF"]
    },
    "check": {
      "outputs": [],
      "env": ["TURBO_PLATFORM"]
    },
    "check:fix": {
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "env": ["TURBO_PLATFORM"]
    },
    "@open-spaced-repetition/binding-test#test": {
      "dependsOn": ["@open-spaced-repetition/binding#build:dynamic"],
      "outputs": [],
      "env": ["NAPI_RS_WASI_FLAVOR"]
    },
    "@open-spaced-repetition/binding#build:dynamic": {
      "outputs": [
        "dist/dynamic-node.js",
        "dist/dynamic-browser.js",
        "dist/dynamic.d.ts",
        "dist/browser.js"
      ]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "env": ["TURBO_PLATFORM"]
    },
    "bench": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@open-spaced-repetition/binding-test#test:coverage": {
      "dependsOn": ["@open-spaced-repetition/binding#build:dynamic"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "docs": {
      "dependsOn": ["build"],
      "outputs": ["../../docs/**"]
    }
  }
}
