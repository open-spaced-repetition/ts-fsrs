{
  "$schema": "./node_modules/turbo/schema.json",
  "globalDependencies": [
    "pnpm-lock.yaml",
    "Cargo.lock",
    "Cargo.toml",
    "packages/*/Cargo.toml",
    "package.json",
    "biome.json",
    ".github/actions/**",
    ".github/workflows/**"
  ],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@open-spaced-repetition/binding#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["NAPI_TARGET"],
      "passThroughEnv": [
        "ANDROID_NDK_LATEST_HOME",
        "CARGO_BUILD_RUSTC_WRAPPER",
        "RUSTC_WRAPPER"
      ]
    },
    "@open-spaced-repetition/binding#build:wasm": {
      "cache": false,
      "env": ["WASI_SDK_PATH"],
      "passThroughEnv": ["CARGO_BUILD_RUSTC_WRAPPER", "RUSTC_WRAPPER"],
      "dependsOn": ["build"]
    },
    "@open-spaced-repetition/binding#build:wasm:threadless": {
      "cache": false,
      "passThroughEnv": ["CARGO_BUILD_RUSTC_WRAPPER", "RUSTC_WRAPPER"]
    },
    "@ts-fsrs/website#prepare:packages": {
      "dependsOn": [
        "@open-spaced-repetition/binding#build:wasm:threadless",
        "ts-fsrs#build"
      ],
      "cache": false
    },
    "@ts-fsrs/website#verify:packages": {
      "dependsOn": ["@ts-fsrs/website#prepare:packages"],
      "outputs": [],
      "cache": false
    },
    "@ts-fsrs/website#prepare:revlog": {
      "outputs": ["src/public/revlog.csv"]
    },
    "@ts-fsrs/website#prepare:sponsors": {
      "cache": false,
      "env": [
        "SPONSORKIT_GITHUB_TOKEN",
        "SPONSORKIT_GITHUB_LOGIN",
        "SPONSORKIT_GITHUB_TYPE"
      ]
    },
    "@ts-fsrs/website#prepare:contributors": {
      "cache": false,
      "env": [
        "CONTRIBUTORS_REPO",
        "CONTRIBUTORS_GITHUB_TOKEN",
        "GITHUB_TOKEN",
        "SPONSORKIT_GITHUB_TOKEN"
      ]
    },
    "@ts-fsrs/website#rspress:build": {
      "dependsOn": [
        "@ts-fsrs/website#verify:packages",
        "@ts-fsrs/website#prepare:revlog",
        "@ts-fsrs/website#prepare:sponsors",
        "@ts-fsrs/website#prepare:contributors"
      ],
      "outputs": ["doc_build/**"],
      "inputs": ["$TURBO_DEFAULT$", ".sponsors.json", ".contributors.json"],
      "env": [
        "DOCS_SITE_ORIGIN",
        "DOCS_BASE",
        "DOCS_INDEXABLE",
        "DOCS_REPO_SLUG",
        "DOCS_REPO_REF"
      ]
    },
    "@ts-fsrs/website#rspress:dev": {
      "dependsOn": [
        "@ts-fsrs/website#verify:packages",
        "@ts-fsrs/website#prepare:revlog",
        "@ts-fsrs/website#prepare:sponsors",
        "@ts-fsrs/website#prepare:contributors"
      ],
      "cache": false,
      "persistent": true,
      "env": [
        "DOCS_SITE_ORIGIN",
        "DOCS_BASE",
        "DOCS_INDEXABLE",
        "DOCS_REPO_SLUG",
        "DOCS_REPO_REF"
      ]
    },
    "@ts-fsrs/website#preview": {
      "dependsOn": ["@ts-fsrs/website#rspress:build"],
      "cache": false,
      "persistent": true
    },
    "@ts-fsrs/website#typecheck": {
      "dependsOn": ["@ts-fsrs/website#verify:packages"],
      "outputs": []
    },
    "@ts-fsrs/website#test:docs": {
      "dependsOn": ["@ts-fsrs/website#verify:packages"],
      "outputs": []
    },
    "check": {
      "outputs": [],
      "env": ["TURBO_PLATFORM"]
    },
    "check:fix": {
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "env": ["TURBO_PLATFORM"]
    },
    "@open-spaced-repetition/binding-test#test": {
      "dependsOn": [
        "^build",
        "@open-spaced-repetition/binding#build:wasm",
        "@open-spaced-repetition/binding#build:dynamic"
      ],
      "outputs": [],
      "env": ["FSRS_BINDING_WASI_FLAVOR", "TURBO_PLATFORM"]
    },
    "@open-spaced-repetition/binding#build:dynamic": {
      "outputs": [
        "dist/dynamic-node.js",
        "dist/dynamic-browser.js",
        "dist/dynamic.d.ts",
        "dist/browser.js"
      ]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "env": ["TURBO_PLATFORM"]
    },
    "bench": {
      "cache": false
    },
    "@open-spaced-repetition/binding-test#test:coverage": {
      "dependsOn": [
        "^build",
        "@open-spaced-repetition/binding#build:wasm",
        "@open-spaced-repetition/binding#build:dynamic"
      ],
      "outputs": ["coverage/**"],
      "env": ["FSRS_BINDING_WASI_FLAVOR", "TURBO_PLATFORM"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@ts-fsrs/website#test:e2e": {
      "dependsOn": ["rspress:build"],
      "outputs": [],
      "cache": false
    },
    "@open-spaced-repetition/binding#check": {
      "outputs": [],
      "passThroughEnv": ["CARGO_BUILD_RUSTC_WRAPPER", "RUSTC_WRAPPER"]
    },
    "ts-fsrs#typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "ts-fsrs#bench": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:ci": {
      "dependsOn": ["test"],
      "outputs": []
    },
    "@open-spaced-repetition/binding-test#test:ci": {
      "dependsOn": ["@open-spaced-repetition/binding#build:dynamic"],
      "outputs": [],
      "cache": false,
      "env": ["FSRS_BINDING_WASI_FLAVOR", "TURBO_PLATFORM"]
    },
    "test:coverage:ci": {
      "dependsOn": ["test:coverage"],
      "outputs": []
    },
    "@open-spaced-repetition/binding-test#test:coverage:ci": {
      "dependsOn": ["@open-spaced-repetition/binding#build:dynamic"],
      "outputs": ["coverage/**"],
      "cache": false,
      "env": ["FSRS_BINDING_WASI_FLAVOR", "TURBO_PLATFORM"]
    }
  }
}
